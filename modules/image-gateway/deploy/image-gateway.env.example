# Environment for the launchd-managed image-gateway service.
#
#   cp deploy/image-gateway.env.example deploy/image-gateway.env
#   chmod 600 deploy/image-gateway.env      # it holds a credential
#
# install-service.sh creates this file for you (with the secrets it finds in
# data/) if it does not exist, so you may not need to touch it by hand.
#
# This file is gitignored. Keep it that way: it is the one place a secret is
# allowed to sit, and it is deliberately not the plist, because the plist in
# ~/Library/LaunchAgents is world-readable.
#
# Everything here is optional. Anything omitted falls back to the app's own
# default, and the wrapper additionally falls back to data/access-token and
# data/device-id for the two secrets.

# --- the two credentials -----------------------------------------------------

# The shared secret *your clients* present, as `X-Relay-Token` or
# `Authorization: Bearer`. This is ours, not the origin's. Empty means the
# gateway is open; the wrapper refuses to start in that state.
IMAGE_GATEWAY_ACCESS_TOKEN=

# The credential the gateway presents *to the origin* as its device header
# (name in app/upstream.py; `X-Device-Id` is the stand-in used in this file).
# Shape `web-<uuid>`. Take it from your own browser capture -- the value from
# the original capture was a real credential and is not shipped in this repo.
# Empty means the client's own device header is passed through untouched.
IMAGE_GATEWAY_DEVICE_ID=

# --- the outbound leg --------------------------------------------------------

# The real origin, absolute http(s). Left EMPTY on purpose: this file is meant to
# be copied, and a placeholder host here becomes a live config that looks
# configured and fails DNS on the first call -- a 502 indistinguishable from the
# origin being down. Empty answers 503 no_upstream instead, which names the fix.
IMAGE_GATEWAY_UPSTREAM=

# `mock` here governs the *raw relay* paths (/api/..., /assets/...), not the
# gateway. app/gateway.py never reads this setting: POST /v1/images always goes
# to IMAGE_GATEWAY_UPSTREAM above. Leaving it at `mock` is correct for a gateway-only
# deployment and keeps the relay from forwarding anything by accident.
IMAGE_GATEWAY_MODE=mock

# The outbound leg honours HTTP_PROXY/HTTPS_PROXY when this is true. launchd
# does not inherit your shell, so a proxy exported in .zshrc is invisible here
# -- but set it to false to be explicit if the box has an egress proxy.
IMAGE_GATEWAY_RELAY_TRUST_ENV=false

# --- listener ----------------------------------------------------------------

# 127.0.0.1 keeps the billed endpoint on this machine. Changing this to
# 0.0.0.0 exposes a quota-spending API to the whole network: only do it with a
# token set, and prefer a tunnel over a raw bind.
IMAGE_GATEWAY_HOST=127.0.0.1
IMAGE_GATEWAY_PORT=4399

# Interpreter with fastapi + uvicorn. install-service.sh fills in one it has
# verified; leave blank to let run.sh probe ./.venv then python3.
IMAGE_GATEWAY_PYTHON=

# --- guards ------------------------------------------------------------------

# Requests per minute per credential. 0 disables the limiter.
IMAGE_GATEWAY_RATE_LIMIT_PER_MINUTE=20

# Simultaneous upstream calls; excess callers wait, then get 503. Each slot is
# a paid generation in flight.
IMAGE_GATEWAY_MAX_CONCURRENT_UPSTREAM=2

# Local pre-checks (mode/prompt shape). Off means every request is forwarded and
# the origin judges it -- which is also what makes `POST {}` a real, free
# connectivity probe. See the README before turning this off.
IMAGE_GATEWAY_GATEWAY_VALIDATE=true
