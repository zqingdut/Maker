<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: starts when this user logs in, and stays up.

  Installed to ~/Library/LaunchAgents/@@LABEL@@.plist by install-service.sh,
  which substitutes the @@...@@ tokens. Rendered by hand? Run `plutil -lint` on
  the result before loading it -- launchd's own error for a malformed plist is
  unhelpfully quiet.

  Nothing secret belongs in here: this file is world-readable, which is the
  point. The credentials are read from deploy/image-gateway.env at startup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@@LABEL@@</string>

    <!-- The wrapper, not run.sh: launchd supplies no shell environment, and the
         wrapper is what reconstructs it. See deploy/image-gateway-service.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>@@PROJECT_DIR@@/deploy/image-gateway-service.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@PROJECT_DIR@@</string>

    <!-- launchd's PATH is minimal, and there is no HOME/PATH inheritance from
         your shell at all. The interpreter is named absolutely (in the env file
         the wrapper loads), so this is belt-and-braces for anything uvicorn
         shells out to.
         PYTHONUNBUFFERED keeps stderr flowing into the log file below instead
         of sitting in a 8 KiB block buffer that you never get to read. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but not after a clean exit. That distinction is what
         makes `launchctl kickstart -k` and `launchctl bootout` behave: a
         deliberate stop stays stopped, an unexpected death comes back. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Seconds launchd waits before restarting. Without it, a config error
         becomes a fork bomb of failed startups. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Grace period between SIGTERM and SIGKILL. Generous enough for an
         in-flight upstream call to finish rather than be abandoned mid-billing. -->
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <!-- launchd opens these before exec, so the directory must already exist:
         install-service.sh creates it. These files are append-only and are NOT
         rotated -- see deploy/README.md. -->
    <key>StandardOutPath</key>
    <string>@@LOG_DIR@@/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@@LOG_DIR@@/launchd.err.log</string>
</dict>
</plist>
