# image-gateway configuration. Every value here has a working default, so an empty
# file (or no file at all) is a valid configuration.
#
# NOTE: nothing reads a `.env` file. There is no dotenv call in app/ or run.sh --
# this file is a *reference*, not a loaded config. Export these variables, or pass
# them inline:
#
#   IMAGE_GATEWAY_UPSTREAM=https://upstream.example.com ./run.sh
#
# To set many at once, use a shell file you `source`:
#
#   set -a; . ./my.env; set +a; ./run.sh
#
# For the smallest set that actually reaches the real origin, and the four ways a
# call can silently fail to, see the "Wiring it to the real API" section of README.md.

# --- server -------------------------------------------------------------
IMAGE_GATEWAY_HOST=127.0.0.1
IMAGE_GATEWAY_PORT=4399
# The real backend advertises Kestrel. Set empty to let uvicorn use its own.
IMAGE_GATEWAY_SERVER_HEADER=Kestrel
# The real service sends NO CORS headers (its app is same-origin). "*" is the
# convenient dev default; set empty to reproduce the real behaviour exactly.
IMAGE_GATEWAY_CORS=*

# --- request contract ---------------------------------------------------
# Only "image" was ever observed; anything else returns {"error":"bad_mode"},
# exactly like the real service. Add e.g. "image,video" if you need more.
IMAGE_GATEWAY_MODES=image
IMAGE_GATEWAY_DEFAULT_ASPECT=4:3
# Prompt budget, counted in CHARACTERS (not bytes -- 4000 CJK characters are
# ~12 KB of UTF-8). 0 means no limit.
IMAGE_GATEWAY_MAX_PROMPT_CHARS=4000
# What to do past that budget:
#   truncate (default) -- cut it, generate, and say so via `X-Prompt-Truncated:
#                         true` plus `promptTruncated: true` in the envelope
#   reject             -- 400 {"error":"prompt_too_long"}, the old behaviour
IMAGE_GATEWAY_PROMPT_OVERFLOW=truncate
IMAGE_GATEWAY_MAX_BODY_BYTES=16777216
# The captured call sent X-Device-Id: web-<uuid>. Enforce it or not.
IMAGE_GATEWAY_REQUIRE_DEVICE=false
IMAGE_GATEWAY_DEVICE_PATTERN=^web-[0-9a-fA-F-]{36}$

# --- response -----------------------------------------------------------
# inline | url | openai   -- "inline" matches the captured session (the client
# received the image as a base64 data URL).
IMAGE_GATEWAY_RESPONSE_STYLE=inline
# captured | placeholder  -- "captured" returns the real 1184x864 PNG from
# re.txt; "placeholder" synthesises an image at the requested aspect size.
IMAGE_GATEWAY_VARIANT=captured
IMAGE_GATEWAY_PUBLIC_BASE_URL=
IMAGE_GATEWAY_REPORT_CREDENTIAL=true

# --- simulation ---------------------------------------------------------
IMAGE_GATEWAY_LATENCY_MIN_MS=700
IMAGE_GATEWAY_LATENCY_MAX_MS=2200
# 0.0 never fails; 0.1 fails 10% of calls with the status below.
IMAGE_GATEWAY_FAIL_RATE=0.0
IMAGE_GATEWAY_FAIL_STATUS=502
IMAGE_GATEWAY_DETERMINISTIC=true

# --- assets -------------------------------------------------------------
# not_found | placeholder | proxy
IMAGE_GATEWAY_ASSET_MISS=not_found
# required only when IMAGE_GATEWAY_ASSET_MISS=proxy; falls back to IMAGE_GATEWAY_UPSTREAM
IMAGE_GATEWAY_ASSET_UPSTREAM=

# --- relay / 中转 ---------------------------------------------------------
# mock  = always answer locally (default; never spends money)
# relay = forward matching requests to IMAGE_GATEWAY_UPSTREAM and return its response
IMAGE_GATEWAY_MODE=mock
# The real origin. Empty disables relay entirely. Must be an absolute http(s) URL.
# Empty is also the honest default: a placeholder host here is a config that looks
# set and fails DNS on the first call, which reads as "the origin is down".
IMAGE_GATEWAY_UPSTREAM=
# Only these path prefixes may be forwarded. A relay that forwards anything is an
# open proxy, so keep this tight.
IMAGE_GATEWAY_RELAY_PATHS=/api/,/assets/
IMAGE_GATEWAY_RELAY_TIMEOUT_S=60
# Extra headers to send upstream, as JSON. Auth tokens belong here and NEVER in the
# config API -- /__mock__/state reports these values redacted, and POST
# /__mock__/config refuses the field outright.
# IMAGE_GATEWAY_RELAY_HEADERS={"Authorization":"Bearer <token>"}
# Pass the client's own headers through (minus hop-by-hop and X-Mock-*).
IMAGE_GATEWAY_RELAY_FORWARD_CLIENT_HEADERS=true
# Honour HTTP_PROXY/HTTPS_PROXY for the outbound leg. Needed behind a corporate or
# sandbox proxy.
IMAGE_GATEWAY_RELAY_TRUST_ENV=true

# --- gateway / 中转站 ------------------------------------------------------
# The wrapped, client-facing flow at POST /v1/images. Needs IMAGE_GATEWAY_UPSTREAM.
# Unlike relay mode it does not forward the origin's paths: it holds the
# credentials itself and re-hosts the image, so callers get a short immutable URL
# instead of a multi-megabyte base64 blob.
IMAGE_GATEWAY_GATEWAY_ENABLED=true
# SET THIS. Empty means the gateway is OPEN: anyone who can reach the port can
# spend your upstream quota. /__mock__/gateway says so loudly when it is unset.
#   openssl rand -hex 24
IMAGE_GATEWAY_ACCESS_TOKEN=
# The device id presented upstream, shape web-<uuid>. Clients never see it.
# Deliberately blank: the id in the original capture is a real credential that
# belongs to whoever took that capture, so it is not shipped. Take your own --
# open the origin in a browser and copy its device header (the header's name is
# in app/upstream.py; this file calls it X-Device-Id as a stand-in) --
# and put it here. With this unset the gateway does not override the device
# header at all (it passes the client's own through).
IMAGE_GATEWAY_DEVICE_ID=
# Replace the client's device header with the value above. This is the point of
# putting a gateway in front of this origin.
IMAGE_GATEWAY_OVERRIDE_DEVICE=true
# Where re-hosted images live. Empty means <project>/data/files. Runtime state.
IMAGE_GATEWAY_FILES_DIR=
# Require the access token to fetch /files/* as well. Off by default so that a
# plain <img src="..."> works; ids are 128-bit and unguessable.
IMAGE_GATEWAY_FILES_REQUIRE_TOKEN=false
# Requests per minute per credential. 0 disables the limiter. Per process, so the
# effective limit multiplies by the worker count.
IMAGE_GATEWAY_RATE_LIMIT_PER_MINUTE=0
# Simultaneous upstream calls. Excess callers queue, then get 503 upstream_busy.
IMAGE_GATEWAY_MAX_CONCURRENT_UPSTREAM=8
IMAGE_GATEWAY_QUEUE_TIMEOUT_S=10
# Retries for the outbound leg. A generation is PAID WORK: a ReadTimeout may mean
# the origin already produced and billed for an image we never saw, so only
# connect-stage failures -- where the request provably never left -- are ever
# retried. 0 is the default for a reason.
IMAGE_GATEWAY_RELAY_RETRIES=0
# true  = rewrite the upstream's inline image into a short URL on this host
# false = hand back the origin's payload untouched (the image is still re-hosted,
#         and the URL is still in the Location header)
IMAGE_GATEWAY_NORMALIZE_RESPONSE=true
# Reject obviously unusable requests locally instead of spending an upstream call
# to be told so. Only checks we can reproduce identically to the origin are
# applied; `aspect` is never judged here because our size table is a local guess.
IMAGE_GATEWAY_GATEWAY_VALIDATE=true

# --- observability ------------------------------------------------------
# Append every request to the JSONL file below. The in-memory ring buffer that
# backs GET /__mock__/requests is always on and does not depend on this.
IMAGE_GATEWAY_LOG_REQUESTS=true
IMAGE_GATEWAY_LOG_PATH=
