# runtime state -- never commit, and never let a git clean take it out
capture/requests.jsonl
capture/requests.*.jsonl

# re-hosted images (IMAGE_GATEWAY_FILES_DIR default). Runtime state: content-addressed,
# reproducible from the origin, and potentially gigabytes.
data/

# launchd service environment -- holds the gateway token and the upstream device
# id. install-service.sh writes it, chmod 600. The annotated template that IS
# tracked is deploy/image-gateway.env.example.
deploy/image-gateway.env

# scratch
.pytest-work/
.pytest-tmp/
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
.env
