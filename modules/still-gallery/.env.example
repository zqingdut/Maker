# Still Gallery — 环境变量模板
#
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，请勿提交。
# 本项目自身不读取 .env 文件，请在启动进程时把变量注入环境，例如：
#   ARK_API_KEY=xxx npm start
#   # 或
#   set -a && source .env && set +a && npm start

# ── 生图接口（火山方舟 Ark / Doubao Seedream）─────────────────────────
# 在方舟控制台「API Key 管理」页面创建长效密钥。
# 设置后界面中的密钥输入框会被锁定，环境变量优先级最高。
ARK_API_KEY=

# 接口基础地址，留空则使用 https://ark.cn-beijing.volces.com/api/v3
# 使用兼容网关时填该网关的地址（可带或不带 /images/generations 后缀）。
ARK_BASE_URL=

# ── 第二套上游：01ai 网关 ────────────────────────────────────────────
# 与方舟是两套独立凭据，切换上游不需要重填。同样：环境变量优先级最高，
# 设置后后台界面里对应的输入框会被锁定（改动返回 409）。
IMAGE_RELAY_TOKEN=

# 网关地址，留空则使用内置默认值。
IMAGE_RELAY_BASE=

# 本机优先尝试的地址，默认 http://127.0.0.1:4399（本机 image-gateway 的端口）。
# 只有连接失败或 404/405（请求肯定没被网关接住）才退回 IMAGE_RELAY_BASE；
# 读超时与 4xx/5xx 绝不回退，因为可能已经出图计费。
# 填 off / none / 0 可关掉本机优先。
IMAGE_RELAY_LOCAL_BASE=

# ── 服务本身 ─────────────────────────────────────────────────────────
# 监听端口与地址，默认 4317 / 127.0.0.1
PORT=4317
HOST=127.0.0.1

# 数据目录，默认 ./data
DATA_DIR=
