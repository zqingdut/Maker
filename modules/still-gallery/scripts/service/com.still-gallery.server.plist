<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ───────────────────────────────────────────────────────────────────
  Still Gallery — launchd 模板（macOS）

  不要直接改这个文件然后 cp 到 ~/Library/LaunchAgents/ —— 里面的 @@...@@
  占位符需要被替换，而且 LaunchDaemon 变体还要额外加一个 UserName 键。
  请用安装脚本：

      ./scripts/service/install-service.sh          # LaunchAgent（登录后启动）
      sudo ./scripts/service/install-service.sh --system   # LaunchDaemon（开机即启动）

  它会把占位符替换好、装到正确的位置、bootstrap 并启动。
  ───────────────────────────────────────────────────────────────────
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LABEL@@</string>

  <!-- 经包装脚本启动：launchd 没有 EnvironmentFile，环境变量只能靠脚本 source。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@@RUNNER@@</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@@PROJECT@@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 让包装脚本里的 `command -v node` 能找到 node -->
    <key>PATH</key>
    <string>@@NODE_DIR@@:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>STILL_GALLERY_ENV_FILE</key>
    <string>@@ENV_FILE@@</string>
    <key>STILL_GALLERY_NODE</key>
    <string>@@NODE@@</string>
    <!-- 兜底值；环境变量文件里的同名变量优先 -->
    <key>DATA_DIR</key>
    <string>@@DATA_DIR@@</string>
    <key>HOST</key>
    <string>@@HOST@@</string>
    <key>PORT</key>
    <string>@@PORT@@</string>
  </dict>

  <!-- 加载即启动（LaunchAgent 在用户登录时、LaunchDaemon 在开机时） -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 只在**异常退出**时重启。server.mjs 收到 SIGTERM 会以 0 退出，
       所以 `launchctl kickstart -k` / 正常停止不会被 KeepAlive 立刻撤销。 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- 崩溃后至少隔 10 秒才重启，避免端口占用时疯狂重启刷日志 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>@@LOG_DIR@@/still-gallery.out.log</string>
  <key>StandardErrorPath</key>
  <string>@@LOG_DIR@@/still-gallery.err.log</string>
</dict>
</plist>
